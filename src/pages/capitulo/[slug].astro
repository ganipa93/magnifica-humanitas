---
import Base from '../../layouts/Base.astro';
import Toc from '../../components/Toc.astro';
import Footer from '../../components/Footer.astro';
import Search from '../../components/Search.astro';
import RefPopover from '../../components/RefPopover.astro';
import { chapters, chapterRange, chapterHref, partId, type Chapter, type Part } from '../../data/structure';
import { OFFICIAL_URL } from '../../data/encyclical';
import { rich, refButton } from '../../lib/rich';
import { siteLinks } from '../../lib/nav';
import { topicsOf, topicHref } from '../../lib/topics';
import { walk } from '../../data/structure';

export function getStaticPaths() {
  return chapters.map((c, i) => ({ params: { slug: c.slug }, props: { i } }));
}

const { i } = Astro.props as { i: number };
const c = chapters[i] as Chapter;
const prev = chapters[i - 1];
const next = chapters[i + 1];
const r = chapterRange(c);
const span = (p: Part) => (p.from === p.to ? `${p.from}` : `${p.from}–${p.to}`);
const name = (p: Part) => (p.untitled ? 'Párrafos iniciales' : p.title);
const total = r.to - r.from + 1;

const links = siteLinks(c.slug);
const leaves = [...walk(c)].filter(({ part }) => !part.parts).map(({ part }) => part.from);
---
<Base title={`${c.label}: ${c.title} · Magnifica Humanitas, explicada`} description={c.lede.replace(/\[§[^\]]+\]/g, '').replace(/\*/g, '')}>
  <header class="band">
    <div class="wrap">
      <p class="crumbs"><a href="/">Magnifica Humanitas, explicada</a> <span aria-hidden="true">/</span> {c.label}</p>
      <h1><span class="lab">{c.label}</span>{c.title}</h1>
      <p class="facts">§ {r.from}–{r.to} · {total} párrafos · {c.sections.filter((s) => !s.untitled).length} secciones</p>
      <p class="lede" set:html={rich(c.lede)} />
      <div class="study" data-leaves={leaves.join(',')}>
        <div class="bar" aria-hidden="true"><span></span></div>
        <p><span data-count data-empty={`${leaves.length} partes · marcá las que vayas leyendo`}>{leaves.length} partes · marcá las que vayas leyendo</span>
          <button type="button" class="print" data-print>Imprimir o guardar en PDF</button></p>
      </div>
      <nav class="course" aria-label={`Secciones de ${c.label}`}>
        {c.sections.map((s) => (
          <a class:list={['brick', { open: s.untitled }]} href={`#${partId(s)}`} style={`flex-grow:${s.to - s.from + 1}`}
            title={s.untitled ? 'Párrafos iniciales, sin subtítulo' : s.title}>
            <span class="t">{s.untitled ? '' : s.title}</span><span class="p">§ {span(s)}</span>
          </a>
        ))}
      </nav>
    </div>
  </header>

  <Toc links={links} home />

  <main id="contenido" class="wrap layout">
    <aside class="rail" aria-label="En este capítulo">
      <ol>
        {c.sections.map((s) => (
          <li>
            <a href={`#${partId(s)}`} data-section={partId(s)} class:list={{ muted: s.untitled }}>{!s.parts && <span class="dot" data-read-dot={s.from} aria-hidden="true" />}{name(s)}</a>
            {s.parts && (
              <ol>
                {s.parts.map((p) => (
                  <li><a href={`#${partId(p)}`} data-section={partId(p)} class:list={{ muted: p.untitled }}><span class="dot" data-read-dot={p.from} aria-hidden="true" />{name(p)}</a></li>
                ))}
              </ol>
            )}
          </li>
        ))}
      </ol>
      <a class="official" href={OFFICIAL_URL} target="_blank" rel="noopener">Leer el original en vatican.va</a>
    </aside>

    <div class="content">
      {c.sections.map((s) => (
        <section class="part" id={partId(s)}>
          <h2 class:list={{ muted: s.untitled }}>{name(s)}</h2>
          <p class="range" set:html={refButton(span(s))} />
          <p class="summary" set:html={rich(s.summary)} />
          {!s.parts && topicsOf(s.from).length > 0 && (
            <p class="tags">Temas: {topicsOf(s.from).map((t) => <a href={topicHref(t)}>{t.label}</a>)}</p>
          )}
          {!s.parts && <button type="button" class="mark" data-mark={s.from} aria-pressed="false">Marcar como leída</button>}
          {s.parts?.map((p) => (
            <article class="sub" id={partId(p)}>
              <h3 class:list={{ muted: p.untitled }}>{name(p)}</h3>
              <p class="range" set:html={refButton(span(p))} />
              <p class="summary" set:html={rich(p.summary)} />
              {topicsOf(p.from).length > 0 && (
                <p class="tags">Temas: {topicsOf(p.from).map((t) => <a href={topicHref(t)}>{t.label}</a>)}</p>
              )}
              <button type="button" class="mark" data-mark={p.from} aria-pressed="false">Marcar como leída</button>
            </article>
          ))}
        </section>
      ))}

      <nav class="pager" aria-label="Otros capítulos">
        {prev ? <a class="prev" href={chapterHref(prev)}><small>Anterior</small>{prev.label}: {prev.title}</a> : <a class="prev" href="/"><small>Volver</small>A la guía</a>}
        {next ? <a class="next" href={chapterHref(next)}><small>Siguiente</small>{next.label}: {next.title}</a> : <a class="next" href="/#frases"><small>Para terminar</small>Frases para citar</a>}
      </nav>
    </div>
  </main>

  <Footer />
  <Search />
  <RefPopover />
</Base>

<style>
.band{background:var(--lapis);color:#F3F1E8;padding:28px 0 32px}
.crumbs{font-family:var(--display);font-stretch:85%;font-size:.95rem;color:#B7BCD6;margin:0 0 28px}
.crumbs a{color:#D7DAEA}
h1{font-family:var(--display);font-stretch:115%;font-weight:800;font-size:clamp(2rem,5vw,3.6rem);line-height:1;letter-spacing:-.015em;margin:0;max-width:18em}
h1 .lab{display:block;font-stretch:70%;font-weight:400;font-size:.42em;letter-spacing:.01em;color:#D9B24A;margin-bottom:.5em}
.facts{font-family:var(--display);font-stretch:80%;color:#B7BCD6;margin:16px 0 0}
.lede{max-width:38em;color:#D7DAEA;margin:20px 0 28px;font-size:1.15rem}
.band :global(.ref){color:#D9B24A}
.course{display:flex;flex-wrap:wrap;gap:6px}
.brick{flex-basis:0;min-width:120px;max-height:110px;background:#E9E6DA;color:#1C2A5E;text-decoration:none;padding:8px 10px 9px;display:flex;flex-direction:column;justify-content:space-between;min-height:58px;border-bottom:3px solid #C5BFA8;transition:background .15s,transform .15s;hyphens:auto}
.brick:hover{background:#fff;transform:translateY(-2px)}
.brick.open{background:#C9C6BA;min-width:36px}
.brick.open .p{color:#3E4470}
.brick .t{font-family:var(--display);font-stretch:80%;font-weight:600;font-size:.88rem;line-height:1.15;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}
.brick .p{font-family:var(--display);font-stretch:70%;font-size:.78rem;color:#5C6390;margin-top:4px}

.layout{display:grid;grid-template-columns:260px 1fr;gap:56px;padding-top:48px;padding-bottom:48px}
.rail{position:sticky;top:calc(var(--toc-h) + 24px);align-self:start;max-height:calc(100dvh - var(--toc-h) - 48px);overflow:auto;font-family:var(--display);font-stretch:85%;font-size:.92rem;line-height:1.3;scrollbar-width:thin}
.rail ol{list-style:none;margin:0;padding:0}
.rail ol ol{margin:4px 0 6px 12px;border-left:1px solid var(--rule);padding-left:10px}
.rail li{margin:0}
.rail a{display:block;padding:5px 0;color:var(--muted);text-decoration:none;border-left:2px solid transparent;margin-left:-12px;padding-left:10px}
.rail ol ol a{margin-left:-12px}
.rail a:hover{color:var(--ink)}
.rail a[aria-current="true"]{color:var(--ink);border-left-color:var(--gold);font-weight:600}
.rail .muted{font-style:italic}
.official{display:inline-block;margin-top:18px;color:var(--muted)}

.content{min-width:0}
.content .part{padding:0 0 40px;margin-bottom:40px;border-bottom:1px solid var(--rule)}
.content .part:last-of-type{border-bottom:0}
h2{font-size:clamp(1.5rem,3vw,2.1rem);margin-bottom:4px}
h3{margin-bottom:2px}
.muted{color:var(--muted);font-style:italic;font-weight:500}
.range{margin:0 0 10px}
.summary{max-width:40em}
.tags{display:flex;flex-wrap:wrap;align-items:baseline;gap:4px 10px;font-family:var(--display);font-stretch:85%;font-size:.88rem;color:var(--muted);margin:-4px 0 0}
.tags a{color:var(--muted);text-decoration:none;border-bottom:1px solid var(--rule)}
.tags a:hover{color:var(--ink);border-bottom-color:var(--gold)}
.sub{margin-top:28px;padding-left:20px;border-left:3px solid var(--stone)}
.sub:target,.part:target{scroll-margin-top:calc(var(--toc-h) + 16px)}

.pager{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:24px}
.pager a{display:block;padding:18px 20px;background:var(--paper);border:1px solid var(--rule);text-decoration:none;font-family:var(--display);font-stretch:90%;font-weight:600;line-height:1.3}
.pager a:hover{border-color:var(--ink)}
.pager small{display:block;font-weight:400;color:var(--muted);margin-bottom:4px}
.pager .next{text-align:right}

.study{margin:-8px 0 26px;max-width:38em}
.study .bar{height:4px;background:#2E3B78}
.study .bar span{display:block;height:100%;background:#D9B24A;transform-origin:left;transform:scaleX(var(--done,0));transition:transform .3s}
.study p{display:flex;flex-wrap:wrap;justify-content:space-between;gap:6px 16px;margin:8px 0 0;font-family:var(--display);font-stretch:85%;font-size:.92rem;color:#B7BCD6}
.study.complete [data-count]{color:#D9B24A}
.print{background:none;border:0;padding:0;color:#D7DAEA;cursor:pointer;text-decoration:underline;text-decoration-color:#D9B24A;text-underline-offset:.2em;font:inherit}
.mark{margin-top:10px;font-family:var(--display);font-stretch:85%;font-size:.9rem;background:none;border:1px solid var(--rule);color:var(--muted);padding:4px 12px;cursor:pointer}
.mark:hover{border-color:var(--muted);color:var(--ink)}
.mark[aria-pressed="true"]{border-color:var(--gold);color:var(--ink)}
.mark[aria-pressed="true"]::before{content:"✓ ";color:var(--gold)}
.rail .dot{display:inline-block;width:6px;height:6px;border-radius:50%;margin:0 7px 1px 0;vertical-align:middle;background:var(--stone)}
.rail .dot.is-read{background:var(--gold)}

@media print{
  .band{background:none;color:#000;padding:0 0 12px}
  .band .crumbs,.band .course,.study,.mark,.tags{display:none}
  .band :global(.ref){color:#000}
  h1,.lede,.facts,.study p{color:#000}
  h1 .lab{color:#000}
  .layout{display:block;padding:0}
  .rail,.pager{display:none}
  .sub{border-left-color:#999}
  .part{break-inside:auto}
  .sub{break-inside:avoid}
}

@media (max-width:900px){
  .layout{grid-template-columns:1fr;gap:0;padding-top:32px}
  .rail{display:none}
}
@media (max-width:640px){
  .course{flex-wrap:wrap}
  .brick{flex-basis:calc(50% - 3px) !important;flex-grow:1 !important}
  .brick.open{display:none}
  .pager{grid-template-columns:1fr}
  .pager .next{text-align:left}
}
</style>

<script>
  import { initStudy } from '../../scripts/study';
  initStudy();
</script>
