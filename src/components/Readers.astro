---
import { audiences } from '../data/encyclical';
import { leafAt, hitTitle } from '../lib/topics';

const groups = audiences.map((a) => ({
  ...a,
  items: a.parts.map((n) => {
    const h = leafAt(n)!;
    const span = h.part.from === h.part.to ? `${h.part.from}` : `${h.part.from}–${h.part.to}`;
    return { title: hitTitle(h), chapter: h.chapter.label, href: h.href, span };
  }),
}));
---
<section id="lectores">
  <div class="wrap">
    <h2>Según quién seas</h2>
    <p class="measure">Una selección de secciones para cada tipo de lector. No es lo único que importa para cada uno: es un buen lugar para empezar. Cada enlace lleva al resumen de la sección, con su párrafo para comprobarlo en el original.</p>
    <div class="grid">
      {groups.map((g) => (
        <section class="card" aria-labelledby={`lec-${g.id}`}>
          <h3 id={`lec-${g.id}`}>{g.label}</h3>
          <ul>
            {g.items.map((i) => (
              <li><a href={i.href}>{i.title}</a><span class="where">{i.chapter} · § {i.span}</span></li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </div>
</section>

<style>
.grid{display:grid;grid-template-columns:1fr 1fr;gap:8px 48px;margin-top:28px}
.card{padding:0;border:0}
h3{border-bottom:2px solid var(--ink);padding-bottom:6px;margin:12px 0 4px}
ul{list-style:none;margin:0;padding:0}
li{padding:10px 0;border-bottom:1px solid var(--rule);display:flex;flex-direction:column;gap:2px}
a{font-family:var(--display);font-stretch:95%;font-weight:600;line-height:1.3}
.where{font-family:var(--display);font-stretch:80%;font-size:.85rem;color:var(--muted)}
@media (max-width:820px){.grid{grid-template-columns:1fr}}
</style>
