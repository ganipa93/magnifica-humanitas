---
import { novelties } from '../data/encyclical';
import { rich, refButton } from '../lib/rich';
---
<section id="nuevo">
  <div class="wrap">
    <h2>Lo que trae de nuevo</h2>
    <p class="measure">Gran parte del texto retoma enseñanzas anteriores. Estos son los puntos donde la encíclica dice algo que antes no estaba dicho, o no con esta fuerza.</p>
    <div class="points">
      {novelties.map((p, i) => (
        <article class="point" id={`nuevo-${i + 1}`}>
          <div class="margin" set:html={refButton(p.ref)} />
          <div>
            <h3>{p.title}</h3>
            <p set:html={rich(p.body)} />
            {p.quote && <blockquote>“{p.quote}”</blockquote>}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
.points{margin-top:36px}
.point{display:grid;grid-template-columns:120px 1fr;gap:24px;padding:26px 0;border-top:1px solid var(--rule)}
.point:last-child{border-bottom:1px solid var(--rule)}
.margin{padding-top:2px}
.margin :global(.ref){font-size:1.05rem}
p{max-width:40em}
blockquote{border-left:3px solid var(--gold);padding-left:14px;margin:10px 0 0;max-width:38em;color:var(--muted)}
@media (max-width:820px){.point{grid-template-columns:1fr;gap:6px}}
</style>
