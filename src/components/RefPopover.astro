---
import { OFFICIAL_URL } from '../data/encyclical';
import { glossary } from '../data/glossary';
import { rich } from '../lib/rich';
---
<div class="pop" id="ref-pop" popover role="dialog" aria-label="Párrafo" data-official={OFFICIAL_URL}>
  <p class="where"></p>
  <div class="actions">
    <a data-act="summary">Leer el resumen de esa sección</a>
    <button type="button" data-act="find">Ver todo lo que cita este párrafo</button>
    <button type="button" data-act="copy">Copiar enlace a la cita</button>
    <a data-act="official" target="_blank" rel="noopener">Abrir el texto oficial en vatican.va</a>
  </div>
</div>
<div class="pop term-pop" id="term-pop" popover role="dialog" aria-labelledby="term-pop-title">
  <p class="where"><b id="term-pop-title" tabindex="-1"></b></p>
  <div class="def"></div>
  <div class="actions"><a data-act="glossary" href="/glosario/">Ver el glosario completo</a></div>
</div>
{glossary.map((t) => (
  <template data-term-def={t.id} data-term-name={t.term}><Fragment set:html={rich(t.def, { terms: false })} /></template>
))}
<div class="toast" role="status" aria-live="polite"></div>
<script>
  import { initRefs } from '../scripts/refs';
  import { initJumps } from '../scripts/jump';
  import { initTerms } from '../scripts/glossary';
  initRefs();
  initJumps();
  initTerms();
</script>
