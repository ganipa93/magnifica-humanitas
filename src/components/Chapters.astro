---
import { structure, chapterSummaries, courseRange } from '../data/encyclical';
import { rich } from '../lib/rich';
---
<section id="capitulos">
  <div class="wrap">
    <h2>Capítulo por capítulo</h2>
    <div class="chapters">
      {structure.map((c) => {
        const s = chapterSummaries[c.id]!;
        const r = courseRange(c);
        return (
          <article class="chapter" id={c.id}>
            <div class="num">{c.short}<small>§ {r.from}–{r.to}</small></div>
            <div>
              <h3>{s.title}</h3>
              <p set:html={rich(s.body)} />
              <ul class="parts" aria-label="Partes">
                {c.blocks.map((b) => (
                  <li><span>{b.title}</span> <button type="button" class="ref" data-ref={b.from === b.to ? `${b.from}` : `${b.from}–${b.to}`} data-first={b.from} aria-haspopup="dialog">§&nbsp;{b.from === b.to ? b.from : `${b.from}–${b.to}`}</button></li>
                ))}
              </ul>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>

<style>
.chapters{margin-top:28px}
.chapter{display:grid;grid-template-columns:200px 1fr;gap:28px;padding:30px 0;border-top:1px solid var(--rule)}
.num{font-family:var(--display);font-stretch:125%;font-weight:800;font-size:2.4rem;line-height:1;color:var(--gold)}
.num small{display:block;font-stretch:80%;font-weight:500;font-size:.9rem;color:var(--muted);margin-top:8px}
p{max-width:40em}
.parts{list-style:none;margin:4px 0 0;padding:0;display:flex;flex-wrap:wrap;gap:6px 18px;font-family:var(--display);font-stretch:85%;font-size:.95rem;color:var(--muted)}
@media (max-width:820px){.chapter{grid-template-columns:1fr;gap:6px}}
</style>
