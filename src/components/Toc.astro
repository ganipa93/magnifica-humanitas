---
import { sections } from '../data/encyclical';

interface Link { href: string; label: string; section?: string; current?: boolean }
interface Props { links?: Link[]; home?: boolean }
const defaults: Link[] = sections.map((s) => ({ href: `#${s.id}`, label: s.label, section: s.id }));
const { links = defaults, home = false } = Astro.props;
---
<nav class="toc" aria-label={home ? 'Navegación' : 'Secciones'}>
  <div class="wrap">
    {home && <a class="home" href="/" aria-label="Volver a la guía"><span aria-hidden="true">MH</span></a>}
    <div class="links">
      {links.map((l) => (
        <a href={l.href} data-section={l.section} aria-current={l.current ? 'page' : undefined}>{l.label}</a>
      ))}
    </div>
    <div class="tools">
      <button type="button" class="tool search" data-open-search aria-keyshortcuts="Control+K /">
        <svg aria-hidden="true" viewBox="0 0 20 20" width="16" height="16"><circle cx="8.5" cy="8.5" r="5.5" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M13 13l4.5 4.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
        <span>Buscar</span><kbd class="k">Ctrl K</kbd>
      </button>
      <button type="button" class="tool theme" id="theme" aria-label="Cambiar a modo oscuro">
        <svg class="moon" aria-hidden="true" viewBox="0 0 20 20" width="16" height="16"><path d="M15.5 12.5A6.5 6.5 0 0 1 7.5 4.5a6.5 6.5 0 1 0 8 8z" fill="currentColor"/></svg>
        <svg class="sun" aria-hidden="true" viewBox="0 0 20 20" width="16" height="16"><circle cx="10" cy="10" r="3.6" fill="currentColor"/><g stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M10 1.8v2M10 16.2v2M1.8 10h2M16.2 10h2M4.2 4.2l1.4 1.4M14.4 14.4l1.4 1.4M4.2 15.8l1.4-1.4M14.4 5.6l1.4-1.4"/></g></svg>
      </button>
    </div>
  </div>
  <div class="progress" aria-hidden="true"><span></span></div>
</nav>

<style>
.toc{position:sticky;top:0;z-index:10;background:color-mix(in srgb,var(--paper) 92%,transparent);backdrop-filter:blur(10px);border-bottom:1px solid var(--rule)}
.wrap{display:flex;align-items:center;gap:16px;min-height:var(--toc-h)}
.links{display:flex;gap:4px 22px;overflow-x:auto;scrollbar-width:none;flex:1;min-width:0;font-family:var(--display);font-stretch:85%;font-size:.95rem;mask-image:linear-gradient(90deg,#000 calc(100% - 24px),transparent)}
.links::-webkit-scrollbar{display:none}
.links a{text-decoration:none;white-space:nowrap;color:var(--muted);padding:12px 0;position:relative;transition:color .2s}
.links a:hover{color:var(--ink)}
.links a:is([aria-current="true"],[aria-current="page"]){color:var(--ink)}
.links a::after{content:"";position:absolute;left:0;right:0;bottom:6px;height:2px;background:var(--gold);transform:scaleX(0);transform-origin:left;transition:transform .25s}
.links a:is([aria-current="true"],[aria-current="page"])::after{transform:scaleX(1)}
.home{flex:none;display:grid;place-items:center;width:32px;height:32px;background:var(--lapis);color:#E9E6DA;text-decoration:none;font-family:var(--display);font-stretch:75%;font-weight:800;font-size:.85rem;border-bottom:3px solid #D9B24A}
.tools{display:flex;gap:6px;flex:none}
.tool{display:inline-flex;align-items:center;gap:8px;background:none;border:1px solid var(--rule);color:var(--muted);padding:4px 10px;cursor:pointer;font-family:var(--display);font-stretch:85%;font-size:.95rem;min-height:32px}
.tool:hover{color:var(--ink);border-color:var(--muted)}
.theme .sun{display:none}
:global(:root[data-theme="dark"]) .theme .moon{display:none}
:global(:root[data-theme="dark"]) .theme .sun{display:block}
@media (prefers-color-scheme: dark){
  :global(:root:not([data-theme="light"])) .theme .moon{display:none}
  :global(:root:not([data-theme="light"])) .theme .sun{display:block}
}
.progress{position:absolute;left:0;right:0;bottom:-1px;height:2px}
.progress span{display:block;height:100%;background:var(--gold);transform-origin:left;transform:scaleX(var(--p,0))}
@media (max-width:640px){
  .search span,.search .k{display:none}
}
@media (hover:none){.search .k{display:none}}
</style>

<script>
  import { initToc } from '../scripts/toc';
  import { initTheme } from '../scripts/theme';
  initToc();
  initTheme();
</script>
