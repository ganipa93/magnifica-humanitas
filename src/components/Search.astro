---
import { buildIndex, buildMap } from '../lib/search-index';
const index = buildIndex();
const map = buildMap();
---
<dialog class="search" aria-label="Buscar en la guía" data-search>
  <form method="dialog" class="bar" role="search">
    <svg aria-hidden="true" viewBox="0 0 20 20" width="20" height="20"><circle cx="8.5" cy="8.5" r="5.5" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M13 13l4.5 4.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
    <input type="search" name="q" autocomplete="off" spellcheck="false"
      placeholder="Una palabra o un número de párrafo, como 107"
      aria-label="Buscar" aria-controls="search-results" aria-autocomplete="list" role="combobox" aria-expanded="true">
    <button type="submit" class="close" aria-label="Cerrar">Esc</button>
  </form>
  <p class="locate" aria-live="polite" hidden></p>
  <ul id="search-results" class="results" role="listbox" aria-label="Resultados"></ul>
  <p class="hint">
    <span><kbd>↑</kbd> <kbd>↓</kbd> para moverte</span>
    <span><kbd>Enter</kbd> para ir</span>
  </p>
</dialog>
<script type="application/json" id="search-data" set:html={JSON.stringify({ index, map })} />

<style>
.search{
  width:min(640px,calc(100vw - 24px));max-height:min(620px,calc(100dvh - 48px));margin:10vh auto auto;padding:0;
  background:var(--paper);color:var(--ink);border:1px solid var(--rule);box-shadow:var(--shadow);
  display:none;flex-direction:column;
}
.search[open]{display:flex}
.search::backdrop{background:rgba(16,20,43,.45);backdrop-filter:blur(2px)}
@media (prefers-reduced-motion: no-preference){
  .search[open]{animation:drop .18s ease-out}
  @keyframes drop{from{opacity:0;transform:translateY(-8px)}}
}
.bar{display:flex;align-items:center;gap:12px;padding:14px 16px;border-bottom:1px solid var(--rule);color:var(--muted)}
input{flex:1;min-width:0;border:0;background:none;color:var(--ink);font-family:var(--display);font-stretch:90%;font-size:1.2rem;outline:none}
input::-webkit-search-cancel-button{display:none}
.close{background:none;border:1px solid var(--rule);color:var(--muted);font-family:var(--display);font-stretch:80%;font-size:.8rem;padding:2px 6px;cursor:pointer}
.locate{margin:0;padding:12px 16px;background:var(--gold-soft);font-family:var(--display);font-stretch:90%;font-size:.95rem}
.results{list-style:none;margin:0;padding:6px;overflow-y:auto;flex:1}
.results :global(li){padding:10px 12px;cursor:pointer;display:grid;grid-template-columns:1fr auto;gap:2px 12px;border-left:3px solid transparent}
.results :global(li[aria-selected="true"]){background:var(--vellum);border-left-color:var(--gold)}
.results :global(.k){grid-column:1;font-family:var(--display);font-stretch:80%;font-size:.8rem;color:var(--muted)}
.results :global(.t){grid-column:1;font-family:var(--display);font-stretch:90%;font-weight:600;line-height:1.3}
.results :global(.x){grid-column:1;font-size:.92rem;color:var(--muted);line-height:1.45;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.results :global(.r){grid-column:2;grid-row:1 / span 3;align-self:center;font-family:var(--display);font-stretch:75%;font-weight:600;color:var(--gold);white-space:nowrap}
.results :global(mark){background:var(--gold-soft);color:inherit}
.results :global(.empty){display:block;cursor:default;color:var(--muted);padding:18px 12px}
.hint{display:flex;gap:18px;margin:0;padding:10px 16px;border-top:1px solid var(--rule);font-family:var(--display);font-stretch:85%;font-size:.85rem;color:var(--muted)}
@media (hover:none){.hint{display:none}}
@media (max-width:640px){.search{margin-top:12px}}
</style>

<script>
  import { initSearch } from '../scripts/search';
  initSearch();
</script>
