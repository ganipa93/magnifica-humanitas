---
import { topics } from '../data/topics';
import { topicHits, topicSpans, topicHref, paragraphsIn } from '../lib/topics';
import TopicStrip from './TopicStrip.astro';
---
<section id="temas">
  <div class="wrap">
    <h2>Recorridos por tema</h2>
    <p class="measure">Si venís con una pregunta puntual, empezá por acá. Cada recorrido junta las secciones de todos los capítulos que tratan ese tema. La franja muestra dónde aparece dentro de los 245 párrafos, de la introducción a la conclusión.</p>
    <ul class="list">
      {topics.map((t) => {
        const n = topicHits(t).length;
        return (
          <li>
            <a href={topicHref(t)}>
              <span class="name">{t.label}</span>
              <span class="count">{n} {n === 1 ? 'sección' : 'secciones'} · {paragraphsIn(t)} párrafos</span>
              <TopicStrip spans={topicSpans(t)} label={`${t.label}: dónde aparece en la encíclica`} />
              <span class="intro">{t.intro}</span>
            </a>
          </li>
        );
      })}
    </ul>
  </div>
</section>

<style>
.list{list-style:none;margin:28px 0 0;padding:0;display:grid;grid-template-columns:1fr 1fr;gap:0 40px}
li{border-top:1px solid var(--rule)}
a{display:grid;grid-template-columns:1fr auto;gap:6px 12px;padding:18px 0;text-decoration:none}
.name{font-family:var(--display);font-stretch:95%;font-weight:650;font-size:1.15rem;line-height:1.25}
.count{font-family:var(--display);font-stretch:80%;font-size:.85rem;color:var(--muted);align-self:center;white-space:nowrap}
a :global(.strip){grid-column:1 / -1}
.intro{grid-column:1 / -1;color:var(--muted);font-size:1rem;line-height:1.5}
a:hover .name{text-decoration:underline;text-decoration-color:var(--gold);text-underline-offset:.2em}
@media (max-width:820px){.list{grid-template-columns:1fr}}
</style>
